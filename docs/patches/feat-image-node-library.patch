From c1e38d803e4b81acf55a5f7890102bad93fdf8eb Mon Sep 17 00:00:00 2001
From: maoshutalk <maoshutalk@gmail.com>
Date: Sat, 18 Jul 2026 21:22:05 +1000
Subject: [PATCH 2/2] fix(canvas-picker): load local assets from
 /api/asset-library
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Plan 2 picker called GET /api/asset-library/items?limit=200, but only
POST /api/asset-library/items exists in main.py — local items were
always empty. Switch to GET /api/asset-library (returns the full library
document) and flatten libraries[].categories[].items[] (filtering
image-type categories) into the picker grid.

Verified end-to-end via agent-browser against http://192.168.50.150:3008:
- "素材库" button on a blank image node opens picker
- Picker shows both real assets (角色 / 场景) with thumbnails
- Clicking a thumb mutates the node url + name and closes the modal

Co-Authored-By: claude-sonnet-4-6 <noreply@anthropic.com>
---
 static/js/canvas-image-picker.js | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/static/js/canvas-image-picker.js b/static/js/canvas-image-picker.js
index 7887750..a84231b 100644
--- a/static/js/canvas-image-picker.js
+++ b/static/js/canvas-image-picker.js
@@ -26,9 +26,26 @@
         state.loading = true;
         try {
             if (state.scope === 'local') {
-                const r = await fetch('/api/asset-library/items?limit=200', { credentials: 'same-origin' });
+                const r = await fetch('/api/asset-library', { credentials: 'same-origin' });
                 const data = await r.json();
-                state.items = (data.items || []);
+                const lib = data && data.library ? data.library : data;
+                const allItems = [];
+                const libs = (lib && lib.libraries) || [];
+                libs.forEach(l => {
+                    (l.categories || []).forEach(cat => {
+                        if(cat.type && cat.type !== 'image') return;
+                        (cat.items || []).forEach(item => {
+                            if(!item.url) return;
+                            allItems.push({
+                                id: item.id,
+                                url: item.url,
+                                name: item.name || '',
+                                kind: item.kind || 'image',
+                            });
+                        });
+                    });
+                });
+                state.items = allItems;
             } else if (state.scope.startsWith('vi:')) {
                 const sourceId = state.scope.slice(3);
                 const params = new URLSearchParams();
